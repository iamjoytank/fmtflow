{
  "name": "fmtflow",
  "version": "1.0.0",
  "description": "Fluent, chainable number formatting powered by Intl.NumberFormat",
  "author": "iamjoytank",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iamjoytank/fmtflow.git"
  },
  "homepage": "https://github.com/iamjoytank/fmtflow#readme",
  "bugs": {
    "url": "https://github.com/iamjoytank/fmtflow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "intl",
    "number",
    "format",
    "currency",
    "i18n",
    "formatter",
    "locale",
    "fluent",
    "builder"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
