{
  "name": "fmtflow",
  "version": "1.3.2",
  "description": "Fluent number, currency, percent and unit formatting library for JavaScript using Intl.NumberFormat",
  "author": "iamjoytank",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamjoytank/fmtflow.git"
  },
  "homepage": "https://github.com/iamjoytank/fmtflow#readme",
  "bugs": {
    "url": "https://github.com/iamjoytank/fmtflow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "format",
    "formatter",
    "number format",
    "currency format",
    "intl",
    "intl numberformat",
    "compact number",
    "number formatting",
    "javascript formatter",
    "typescript formatter",
    "currency formatter",
    "percent formatter",
    "unit formatter",
    "format pipeline",
    "fluent api",
    "number utils"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
